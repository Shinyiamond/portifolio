/* Definição de variáveis */
:root {
  --botao-ativo: #27272a;
  --verde: #00f58d;
  --texto-fundo: #18181b;
}

/* Botões e estado ativo */
.botao.ativo {
  background-color: var(--botao-ativo);
  border-bottom: 4px solid var(--verde);
}

/* Área do conteúdo e abas */
.abas-textos {
  background-color: var(--texto-fundo);
  padding: 40px;
  border-radius: 0 0 40px 40px;
}

/* Oculta abas inativas e exibe a ativa */
.aba-conteudo {
  display: none;
}

.aba-conteudo.ativo {
  display: block;
}

/* Títulos */
.aba-conteudo-titulo-principal {
  font-size: 28px;
  text-align: center;
}

.aba-conteudo-titulo-secundario {
  text-align: center;
  color: var(--verde);
  text-transform: uppercase;
}

/* Layout do contador */
.contador {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.contador-digito {
  padding: 0 16px;
  text-align: center;
  min-width: 100px;
}

.contador-digito-numero {
  font-size: 80px;
  margin: 0;
}

.contador-digito-texto {
  color: var(--verde);
  font-size: 20px;
  margin: 0;
}
